{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit":              false,
    "emitDeclarationOnly": true,
    "declaration":         true,
    "declarationMap":      true,
    "outDir":              "dist",
    // allowImportingTsExtensions requires noEmit; strip it for the build config
    "allowImportingTsExtensions": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "tests/**/*"]
}
