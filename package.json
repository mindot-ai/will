{
  "name": "@mindot/will",
  "version": "0.5.0",
  "author": "Fabrice <fabrice8@github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mindot-ai/will.git"
  },
  "bin": {
    "will": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "devDependencies": {
    "@types/bun": "latest",
    "tsup": "^8.5.1",
    "typescript": "^5.9.0",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.0.0"
  },
  "optionalDependencies": {
    "baileys": "^7.0.0-rc13",
    "discord.js": "^14.16.3",
    "qrcode-terminal": "^0.12.0",
    "socket.io-client": "^4.8.1"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./mcp": {
      "import": "./dist/mcp/effectors.js",
      "types": "./dist/mcp/effectors.d.ts"
    },
    "./discord": {
      "import": "./dist/channels/discord.js",
      "types": "./dist/channels/discord.d.ts"
    },
    "./whatsapp": {
      "import": "./dist/channels/whatsapp.js",
      "types": "./dist/channels/whatsapp.d.ts"
    }
  },
  "bugs": {
    "url": "https://github.com/mindot-ai/will/issues"
  },
  "description": "Will \u2014 an engine for persistent machine minds. A Will is a continuously-ticking synthetic mind built from 38 cognitive faculties, a learning agency pipeline, and a dual-process executive \u2014 deterministic, persistent, and portable (PMA).",
  "engines": {
    "bun": ">=1.0.0"
  },
  "files": [
    "dist",
    "src"
  ],
  "homepage": "https://github.com/mindot-ai/will#readme",
  "keywords": [
    "ai",
    "agent",
    "ai-agents",
    "cognitive-architecture",
    "generative-agents",
    "persistent-memory",
    "simulation",
    "autonomous-agent",
    "llm",
    "npc",
    "mind",
    "deterministic"
  ],
  "license": "Apache-2.0",
  "packageManager": "bun@1.3.9",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "build:types": "tsc --project tsconfig.build.json",
    "dev": "bun --env-file=.env run src/runners/thin-shim.runner.ts",
    "dev:build": "tsup --watch",
    "run:social": "bun --env-file=.env run src/runners/social.runner.ts",
    "run:outreach": "bun --env-file=.env run src/runners/outreach.runner.ts",
    "start": "bun --env-file=.env run src/runners/thin-shim.runner.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "prepublishOnly": "bun run typecheck && bun test && bun run build",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:integration": "vitest run src/tests/integration"
  },
  "type": "module",
  "types": "./dist/index.d.ts"
}
