# ── LLM Provider ────────────────────────────────────────────
# Both are REQUIRED for a live mind — the engine has no default vendor and no
# default model. A guess here is how a key meant for one vendor reaches another.
#
#   anthropic  glm  openai  google  deepseek  moonshot  qwen  xai  minimax
#   mistral  ollama  vllm      … or any other name, once it declares its
#                                `wire` + `baseUrl` (see README → LLM provider)
#
# anthropic and glm speak the Anthropic wire: streaming, prompt cache, TTFT
# deadline. The rest speak OpenAI or Gemini — non-streaming today.
WILL_LLM_PROVIDER=anthropic
WILL_LLM_MODEL=claude-sonnet-4-5-20250929
WILL_LLM_TIMEOUT_MS=90000	# first-byte (TTFT) deadline for the streaming executive call

# NOTE: WILL_LLM_MODEL pins EVERY thinking role. For different models per role,
# leave it unset and configure `llm.model` (a map) or `llm.router` in code.

# GLM instead — an always-on mind on open weights at ~1/2 the rate:
#   WILL_LLM_PROVIDER=glm
#   WILL_LLM_MODEL=glm-5.2          # or glm-5.2[1m] for the 1M-token context
#   ZAI_API_KEY=…                   # its presence alone selects glm
# Point glm at any ANTHROPIC-compatible endpoint (a gateway, or one fronting the
# open weights). A bare vLLM/SGLang self-host speaks OpenAI, not Anthropic — so
# it belongs on WILL_LLM_PROVIDER=vllm (or ollama), not glm.
#   WILL_LLM_BASE_URL=http://localhost:8000/v1

# ── LLM Provider API Keys ─────────────────────────────────────────────────
# Each is read ONLY for the provider it belongs to — a Will on one vendor can
# never be handed another's key. WILL_LLM_API_KEY overrides them all, but it
# says nothing about who to send it to, so it requires WILL_LLM_PROVIDER.
ANTHROPIC_API_KEY=sk-your-key-here
ZAI_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=            # or GEMINI_API_KEY — same account
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=          # Kimi
DASHSCOPE_API_KEY=         # Alibaba / Qwen
XAI_API_KEY=               # Grok
MINIMAX_API_KEY=
MISTRAL_API_KEY=

# ── Semantic recall ───────────────────────────────────────────
# Requires a vector store (MASTRA_DB_URL) + an embedding model.
# Set WILL_SEMANTIC_RECALL=false to disable without touching the embedder.
#
# WILL_EMBEDDING_MODEL uses "provider/model" format — same as WILL_LLM_MODEL.
# Set to "none" to disable embedding (and semantic recall) entirely.
# Supported out of the box:
#   openai/text-embedding-3-small   (default, best quality/cost)
#   openai/text-embedding-3-large
#   google/gemini-embedding-001
#   jina/jina-embeddings-v3         (also v4, v2-base-en, clip-v2)
# API key is read from OPENAI_API_KEY / GOOGLE_GENERATIVE_AI_API_KEY / JINA_API_KEY
# automatically, or from WILL_EMBEDDING_API_KEY which overrides all of them.
#
# Index width is set from the model's NATIVE output — no `dimensions` param is sent —
# and is verified against the first vector the provider returns. A mismatch fails with
# the exact WILL_EMBEDDING_DIMENSIONS to set rather than building an index that can
# never match. Set that variable to override (e.g. Jina v3's Matryoshka truncation).
#
# Note on rate limits: a mind consolidating continuously indexes several episodes per
# tick. A free tier will 429 steadily — indexing degrades to "deferred" and recall to
# "no recall", so nothing crashes, but episodic memory stops accumulating.
#
# Using Ollama / local LLMs → set both to none/false (no embedding support)
WILL_SEMANTIC_RECALL=true
WILL_EMBEDDING_MODEL=google/gemini-embedding-001

# ── Affective tuning ─────────────────────────────────────────
WILL_SELF_BELONGING=0.35
WILL_CURIOSITY_FLOOR=0.08
WILL_BOREDOM_RATE=0.005

# ── Simulation tuning ────────────────────────────────────────
WILL_TICK_MS=1000
WILL_MAX_TICKS=0
WILL_LOG_INTERVAL=10
WILL_RESOURCE_ID=agent-self
WILL_LLM_CONCURRENCY=3 # The minimum is 3: orbital, conversation, summary
WILL_THREAD_HISTORY=0
WILL_MAX_INPUT_TOKENS=8000

# ── Snapshot tuning ──────────────────────────────────────────
WILL_SNAPSHOT_INTERVAL=10
WILL_SNAPSHOT_PERSIST=100
WILL_SNAPSHOT_PATH=./data/snapshots
WILL_SNAPSHOT_MAX_MEMORY=500

# ── Conversation Config ───────────────────────────────────────
WILL_SUMMARY_INTERVAL=10	# Orbital calls between summaries
WILL_SUMMARY_BUFFER_SIZE=12	# Reasoning passes kept in buffer
WILL_CONVERSATION_HISTORY=50	# lastMessages for conversation threads

# ── Discord channel (`will discord` — see docs/discord.md) ────
# Bot token from https://discord.com/developers/applications
# (enable the Message Content intent, then invite the bot).
DISCORD_BOT_TOKEN=
# Comma-separated channel ids the Will inhabits (unset = all it can see)
# WILL_DISCORD_CHANNELS=123456789012345678,234567890123456789
# Perceive guild messages only when @mentioned — DMs always perceived
# WILL_DISCORD_MENTION_ONLY=false
# Fallback channel id for utterances with no reachable addressee
# WILL_DISCORD_HOME_CHANNEL=

# ── WhatsApp channel (`will whatsapp` — docs/channels/whatsapp.md) ──
# No token: first run prints a QR to pair as a linked device (credentials land
# in ./.will/<name>.wa-auth/). UNOFFICIAL protocol — ban risk; use a spare number.
# Comma-separated chat jids the Will inhabits (groups …@g.us, DMs …@s.whatsapp.net)
# WILL_WHATSAPP_CHATS=
# Perceive group messages only when @mentioned — DMs always perceived
# WILL_WHATSAPP_MENTION_ONLY=false
# Fallback chat jid for utterances with no reachable addressee
# WILL_WHATSAPP_HOME_CHAT=